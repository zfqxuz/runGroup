DATABASE_URL="postgresql://touhou:touhou@localhost:5432/touhou_trpg?schema=public"
NEXTAUTH_SECRET="dev-only-change-me"
NEXTAUTH_URL="http://localhost:3100"
HOST="localhost"
PORT="3100"
UPLOAD_DIR="./uploads"

# DeepSeek / DSH 平台模型（n8n 工作流与回退导入都需要）
DEEPSEEK_API_KEY="sk-your-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

# n8n 团本解析工作流（推荐）。应用默认通过 Docker 内网调用。
# 服务器 compose 会启动 n8n 并自动导入 n8n/workflows/module-import.json。
N8N_MODULE_PARSE_URL="http://n8n:5678/webhook/module-parse"
N8N_REQUEST_TIMEOUT_MS="1800000"
# n8n 镜像；国内服务器默认走 daocloud 镜像前缀
N8N_IMAGE="docker.m.daocloud.io/n8nio/n8n:2.39.5"
# 可选：n8n Webhook 共享密钥；设置后应用会发送 x-n8n-webhook-secret 请求头。
# N8N_WEBHOOK_SECRET=""
# n8n 编辑器公网 HTTPS 入口（Caddy 反代 + Basic Auth + 自签证书）
N8N_PUBLIC_URL="https://8.141.16.85"
# 可选：固定 n8n 加密密钥，避免重建容器后凭据失效；不填时 n8n 自动生成到卷中。
# N8N_ENCRYPTION_KEY=""

# 团本 dsh 助手（可选；两者都不配置时功能自动关闭）
# 生产 compose 默认已指向 dsh 旁车；DSH_IMAGE 由 deploy.yml 自动写入，无需手工维护。
# DSH_SERVICE_URL="http://dsh:8790"
# DSH_HEADLESS_COMMAND="/path/to/dsh"
# DSH_HEADLESS_ARGS="--profile headless"
# DSH_HOME="/dsh-home"
# DSH_WORKSPACE_ROOT="/tmp/touhou-dsh"
# DSH_TASK_TIMEOUT_MS="300000"
# DSH_MAX_CONCURRENT="1"
