generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum System {
  COC7
  TOUHOU
}

enum UserRole {
  USER
  ADMIN
}

enum RoomStatus {
  LOBBY
  PLAYING
  PAUSED
  COMBAT
  ENDED
}

enum MemberRole {
  KP
  PLAYER
  SPECTATOR
}

enum ReviewStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum CardType {
  WEAPON
  ITEM
  SPELLCARD
  ABILITY
  NPC
  CLUE
}

enum ItemTemplateType {
  WEAPON
  ITEM
  TOME
  ARTIFACT
  EVIDENCE
}

enum CardScope {
  /// 系统预设的通用角色：任何人可用，按 system 区分模组
  PRESET
  COMPENDIUM
  ROOM
  CHARACTER
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum AssetType {
  PORTRAIT
  AVATAR
  TOKEN
  MAP
  SCENE_BG
  CARD_ART
  HANDOUT
  MUSIC
  SOUND
  OTHER
}

enum GridType {
  SQUARE
  HEX
  NONE
}

enum LayerType {
  BACKGROUND
  TILE
  OBJECT
  EFFECT
  FOREGROUND
}

enum WallType {
  WALL
  DOOR
  WINDOW
  DIFFICULT_TERRAIN
}

enum Weather {
  NONE
  RAIN
  SNOW
  FOG
  STORM
  SAKURA
  PETALS
}

enum TimeOfDay {
  DAWN
  DAY
  DUSK
  NIGHT
  MIDNIGHT
}

enum CombatPhase {
  ATB_CHARGING
  ACTION
  RESOLUTION
  ENDED
}

enum MessageType {
  CHAT
  DICE
  SYSTEM
  COMBAT_LOG
  IC
}

enum Channel {
  OOC
  IC
  KP_ONLY
  WHISPER
  SPECTATOR
}

enum ActionType {
  DANMAKU
  SPELLCARD
  DEFEND
  DODGE
  COUNTER
  ITEM
  FLEE
  PASS
}

enum Resolution {
  PENDING
  HIT
  MISS
  CRITICAL
  FUMBLE
  CANCELLED
}

enum RollVisibility {
  PUBLIC
  DARK
  SECRET
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  /// 平台权限：USER / ADMIN。管理员可进入管理后台。
  role         UserRole @default(USER)
  /// 禁用后无法登录，Socket 票据校验也会拒绝。
  isDisabled   Boolean  @default(false)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  characters  Character[]
  memberships RoomMember[]
  messages    Message[]           @relation("MessageAuthor")
  whispers    Message[]           @relation("WhisperTarget")
  assets      Asset[]
  notes       Note[]
  ownedCards  Card[]              @relation("CardOwner")
  clueFinds   ClueDiscovery[]
  rulePacks   RulePack[]
  diceRolls   DiceRoll[]
  ownedRooms  Room[]              @relation("RoomOwner")
  ruleAudits  RuleOverrideAudit[]
  combatRequests CombatRequest[] @relation("CombatRequestInitiator")
  modules     Module[]
  adminAuditLogs AdminAuditLog[]
}

model RulePack {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  system      System
  description String?
  ownerId     String?
  isBuiltin   Boolean  @default(false)
  /// 发布状态：只有已发布的规则包可以在建房时被选择。
  isPublished Boolean  @default(false)
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt

  owner    User?             @relation(fields: [ownerId], references: [id])
  versions RulePackVersion[]
}

model RulePackVersion {
  id            String   @id @default(cuid())
  packId        String
  version       String
  schemaVersion Int      @default(1)
  config        Json
  checksum      String
  isActive      Boolean  @default(false)
  /// DRAFT / PUBLISHED / ARCHIVED
  status        String   @default("DRAFT")
  notes         String?
  createdBy     String?
  publishedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  pack    RulePack @relation(fields: [packId], references: [id], onDelete: Cascade)
  rooms   Room[]
  modules Module[]

  @@unique([packId, version])
  @@index([checksum])
}

model RuleOverrideAudit {
  id        String   @id @default(cuid())
  roomId    String
  actorId   String
  patch     Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  room  Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

model Room {
  id                String     @id @default(cuid())
  name              String
  system            System     @default(COC7)
  ownerId           String
  rulePackVersionId String?
  ruleOverride      Json       @default("{}")
  inviteCode        String     @unique
  status            RoomStatus @default(LOBBY)
  description       String?
  /// 本房间采用的车卡方式 id，由房主在建房时二选一。
  chargenMethod     String?
  /// 角色创建年代。COC7 为 CLASSIC / MODERN，TOUHOU 允许留空。
  era               String?
  /// 玩家是否可以发起战斗申请（KP 仍可直接发起）。
  allowPlayerCombatRequest Boolean @default(true)
  /// 玩家之间是否可见彼此角色属性：PUBLIC / PRIVATE。KP 永远可见全部。
  characterVisibility String @default("PUBLIC")
  /// 本局是否启用模组携带的魔法规则（由 KP 在准备阶段开启）。
  magicEnabled Boolean @default(false)
  /// 准备页当前选中的团本。可以为房间私有团本或广场公开团本。
  selectedModuleId  String?
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)

  owner      User                @relation("RoomOwner", fields: [ownerId], references: [id])
  rulePack   RulePackVersion?    @relation(fields: [rulePackVersionId], references: [id])
  selectedModule Module?          @relation("RoomSelectedModule", fields: [selectedModuleId], references: [id], onDelete: SetNull)
  members    RoomMember[]
  messages   Message[]
  combats    Combat[]
  notes      Note[]
  clues      Clue[]
  scenes     Scene[]
  cards      Card[]
  assets     Asset[]
  modules    Module[]
  diceRolls  DiceRoll[]
  characterEntries RoomCharacterEntry[]
  cardEntries      RoomCardEntry[]
  ruleAudits RuleOverrideAudit[]
  combatRequests   CombatRequest[]
  encounters Encounter[]
  roomChapters RoomChapter[]
  presetApplications RoomPresetApplication[]
  Character  Character[]
  games      Game[]

  @@index([status])
  @@index([selectedModuleId])
}

model RoomMember {
  id                String     @id @default(cuid())
  roomId            String
  userId            String
  role              MemberRole @default(PLAYER)
  activeCharacterId String?
  /// 准备页中的“已准备”状态；KP 开始跑团前要求所有非旁观成员已准备。
  ready             Boolean    @default(false)
  joinedAt          DateTime   @default(now()) @db.Timestamptz(3)

  room            Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCharacter Character? @relation("ActiveCharacter", fields: [activeCharacterId], references: [id])

  @@unique([roomId, userId])
  @@index([roomId, role])
}

model Character {
  id            String       @id @default(cuid())
  userId        String
  roomId        String?
  system        System       @default(COC7)
  reviewStatus  ReviewStatus @default(DRAFT)
  reviewComment String?
  version       Int          @default(1)

  name       String
  playerName String?
  occupation String?
  /// 结构化职业数据；旧角色可能为空，显示时回退到 occupation 文本。
  occupationId String?
  /// 该角色使用的年代；旧角色可能为空，房间审核时由 KP 判断。
  era        String?
  age        Int?
  gender     String?
  residence  String?

  str  Int @default(0)
  con  Int @default(0)
  siz  Int @default(0)
  dex  Int @default(0)
  app  Int @default(0)
  int  Int @default(0)
  pow  Int @default(0)
  edu  Int @default(0)
  luck Int @default(0)

  race     String?
  raceMods Json?

  skills    Json  @default("{}")
  /// 车卡时职业点 / 兴趣点 / 导入来源的分项记录。
  skillAllocation Json?
  /// 从外部人物卡文件导入时的原始数据（仅作回显与排错）。
  sourceData Json?
  backstory Json?

  hp     Int @default(0)
  maxHp  Int @default(0)
  mp     Int @default(0)
  maxMp  Int @default(0)
  san    Int @default(0)
  maxSan Int @default(0)
  dp     Int @default(0)
  maxDp  Int @default(0)

  portraitId String? @unique
  avatarId   String? @unique
  tokenId    String? @unique

  portrait Asset? @relation("CharacterPortrait", fields: [portraitId], references: [id])
  avatar   Asset? @relation("CharacterAvatar", fields: [avatarId], references: [id])
  token    Asset? @relation("CharacterToken", fields: [tokenId], references: [id])

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  room         Room?               @relation(fields: [roomId], references: [id])
  occupationRef Occupation?        @relation(fields: [occupationId], references: [id])
  activeIn     RoomMember[]        @relation("ActiveCharacter")
  cards        Card[]
  roomEntries  RoomCharacterEntry[]
  participants CombatParticipant[]
  tokens       Token[]
  gameCharacters GameCharacter[]
  advancements   CharacterAdvancement[]
  growthChecks   GrowthCheck[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([roomId, reviewStatus])
}

model Occupation {
  id            String   @id @default(cuid())
  system        System
  code          Int
  name          String
  era           String   @default("BOTH")
  creditMin     Int?
  creditMax     Int?
  creditText    String?
  pointsText    String?
  pointsFormula String
  skillsText    String
  skillNames    Json     @default("[]")
  relations     String?
  description   String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt

  characters Character[]

  @@unique([system, code])
  @@index([system, era])
}

model Game {
  id               String   @id @default(cuid())
  roomId           String
  moduleId         String?
  moduleRevisionId String?
  status           String   @default("PREPARING")
  title            String
  startedAt        DateTime?
  endedAt          DateTime?
  createdBy        String
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt

  room           Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  module         Module?                @relation(fields: [moduleId], references: [id])
  moduleRevision ModuleRevision?        @relation(fields: [moduleRevisionId], references: [id], onDelete: SetNull)
  state          GameState?
  characters     GameCharacter[]
  advancements   CharacterAdvancement[]
  growthChecks   GrowthCheck[]

  @@index([roomId, status])
  @@index([moduleRevisionId])
}

model GameState {
  gameId             String   @id
  moduleId           String?
  moduleVersion      String?
  currentChapterId   String?
  currentSceneId     String?
  currentEncounterId String?
  gameTime           String?
  paused             Boolean  @default(false)
  flags              Json     @default("{}")
  counters           Json     @default("{}")
  custom             Json     @default("{}")
  version            Int      @default(1)
  updatedAt          DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model GameCharacter {
  id          String   @id @default(cuid())
  gameId      String
  characterId String
  userId      String
  status      String   @default("ALIVE")
  currentHp   Int
  currentMp   Int
  currentSan  Int
  currentDp   Int      @default(0)
  conditions  Json     @default("[]")
  state       Json     @default("{}")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt

  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([gameId, characterId])
  @@index([userId])
}

model CharacterAdvancement {
  id          String   @id @default(cuid())
  characterId String
  gameId      String?
  kind        String
  target      String?
  delta       Int?
  note        String?
  /// 来源：MANUAL / END_REWARD / GROWTH_CHECK / MODULE / IMPORT / OTHER
  source      String   @default("MANUAL")
  /// 记录人；旧数据可能为空。
  createdBy   String?
  /// 规则细节快照，例如成长检定的 before / roll / gain。
  metadata    Json     @default("{}")
  editedAt    DateTime? @db.Timestamptz(3)
  revertedAt  DateTime? @db.Timestamptz(3)
  revertedBy  String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  game      Game?     @relation(fields: [gameId], references: [id])

  @@index([characterId, createdAt])
  @@index([characterId, revertedAt])
}

model GrowthCheck {
  id          String   @id @default(cuid())
  gameId      String
  characterId String
  skillId     String
  skillName   String?
  /// PENDING / PASSED / FAILED / CANCELLED
  state       String   @default("PENDING")
  beforeValue Int
  roll        Int?
  gain        Int?
  note        String?
  createdBy   String?
  resolvedBy  String?
  resolvedAt  DateTime? @db.Timestamptz(3)
  /// 检定成功时生成的成长记录。
  advancementId String? @unique
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt

  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([gameId, characterId, skillId])
  @@index([gameId, state])
  @@index([characterId, createdAt])
}

model Card {
  id          String    @id @default(cuid())
  scope       CardScope
  templateId  String?
  ownerId     String?
  characterId String?
  roomId      String?

  type        CardType
  name        String
  subtitle    String?
  description String?

  imageUrl     String?
  thumbnailUrl String?
  rarity       Rarity  @default(COMMON)
  frameColor   String?

  stats      Json    @default("{}")
  system     System  @default(COC7)
  isEquipped Boolean @default(false)
  equipSlot  String?
  quantity   Int     @default(1)
  pointCost  Int     @default(0)
  /// 是否作为跨用户可见的共享模板卡。
  isTemplate Boolean @default(false)
  /// NPC / Boss 卡是否对玩家公开属性；默认隐藏，只能看到战斗中的伤害。
  isPublic Boolean @default(false)

  owner     User?      @relation("CardOwner", fields: [ownerId], references: [id])
  character Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  room      Room?      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  template  Card?      @relation("CardTemplate", fields: [templateId], references: [id])
  instances Card[]     @relation("CardTemplate")
  roomEntries RoomCardEntry[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt

  @@index([characterId, scope])
  @@index([roomId, type])
  @@index([scope, isTemplate])
  @@index([templateId])
}

model Asset {
  id           String    @id @default(cuid())
  ownerId      String
  roomId       String?
  type         AssetType
  filename     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  url          String
  thumbnailUrl String?
  checksum     String?
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  owner             User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  room              Room?      @relation(fields: [roomId], references: [id])
  portraitOf        Character? @relation("CharacterPortrait")
  avatarOf          Character? @relation("CharacterAvatar")
  tokenOf           Character? @relation("CharacterToken")
  mapBackgroundOf   Map[]      @relation("MapBackground")
  sceneBackgroundOf Scene[]    @relation("SceneBackground")
  layers            MapLayer[]
  tokens            Token[]
  clues             Clue[]
  moduleAssets      ModuleAsset[]
  moduleRevisionAssets ModuleRevisionAsset[]

  @@index([ownerId])
  @@index([roomId, type])
  @@index([checksum])
}

model Module {
  id                String  @id @default(cuid())
  ownerId           String?
  roomId            String?
  rulePackVersionId String?
  slug              String?
  title             String
  synopsis          String?
  author            String?
  system            String?
  era               String?
  /// 广场预览字段：背景 / 时代氛围。
  background        String?
  /// 广场预览字段：推荐职业 / 角色方向。
  occupationRecommendation String?
  version           String  @default("1.0.0")
  isPublished       Boolean @default(false)
  publishedAt       DateTime? @db.Timestamptz(3)
  sourceType        String  @default("NATIVE")
  originalFilename  String?
  packagePath       String?
  metadata          Json    @default("{}")
  importReport      Json    @default("{}")
  content           Json    @default("{}")

  owner    User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  room     Room?            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  selectedByRooms Room[]    @relation("RoomSelectedModule")
  pack     RulePackVersion? @relation(fields: [rulePackVersionId], references: [id])
  chapters ModuleChapter[]
  assets   ModuleAsset[]
  games    Game[]
  revisions ModuleRevision[]
  chapterTemplates ChapterTemplate[]
  sceneTemplates   SceneTemplate[]
  npcTemplates     NpcTemplate[]
  itemTemplates    ItemTemplate[]
  clueTemplates    ClueTemplate[]
  encounterTemplates EncounterTemplate[]
  magicTemplates   MagicTemplate[]
  presetApplications RoomPresetApplication[]

  @@index([roomId, slug])
  @@index([ownerId, isPublished])
  @@index([isPublished, publishedAt])
}

model ModuleAsset {
  id           String   @id @default(cuid())
  moduleId     String
  assetId      String
  relativePath String
  originalName String?
  kind         String
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([moduleId, relativePath])
  @@index([moduleId, kind])
}

/// 开局时的团本快照，保证已开始的局与历史局不受后续编辑影响。
model ModuleRevision {
  id                       String   @id @default(cuid())
  moduleId                 String?
  version                  String
  title                    String
  author                   String?
  system                   String?
  era                      String?
  background               String?
  occupationRecommendation String?
  synopsis                 String?
  metadata                 Json     @default("{}")
  content                  Json     @default("{}")
  contentHash              String
  createdAt                DateTime @default(now()) @db.Timestamptz(3)

  module Module?               @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  assets ModuleRevisionAsset[]
  games  Game[]

  @@unique([moduleId, contentHash])
  @@index([moduleId, createdAt])
}

/// 快照中的团本资源引用。资源被进行中的局使用时，清理逻辑会跳过。
model ModuleRevisionAsset {
  id           String   @id @default(cuid())
  revisionId   String
  assetId      String?
  relativePath String
  originalName String?
  kind         String
  orderIndex   Int      @default(0)
  url          String
  mimeType     String?
  size         Int?
  width        Int?
  height       Int?

  revision ModuleRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  asset    Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([revisionId, relativePath])
  @@index([assetId])
  @@index([revisionId, orderIndex])
}

model ModuleChapter {
  id         String  @id @default(cuid())
  moduleId   String
  title      String
  orderIndex Int
  summary    String?

  module     Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  encounters Encounter[]

  @@index([moduleId, orderIndex])
}

model Encounter {
  id            String  @id @default(cuid())
  chapterId     String?
  roomChapterId String?
  roomId        String?
  sceneId       String?
  title         String
  trigger       String?
  setup         Json    @default("{}")
  orderIndex    Int

  chapter     ModuleChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  roomChapter RoomChapter?  @relation("EncounterRoomChapter", fields: [roomChapterId], references: [id], onDelete: SetNull)
  room        Room?          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  scene       Scene?         @relation(fields: [sceneId], references: [id])

  @@index([chapterId, orderIndex])
  @@index([roomChapterId, orderIndex])
}

model Scene {
  id          String  @id @default(cuid())
  roomId      String
  name        String
  description String?

  backgroundId   String?
  bgMusicId      String?
  ambientSoundId String?

  weather       Weather   @default(NONE)
  timeOfDay     TimeOfDay @default(DAY)
  lighting      String    @default("normal")
  filterColor   String?
  filterOpacity Float     @default(0)
  narration     String?
  isActive      Boolean   @default(false)
  orderIndex    Int       @default(0)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  room       Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  background Asset?      @relation("SceneBackground", fields: [backgroundId], references: [id])
  map        Map?
  encounters Encounter[]

  @@index([roomId, orderIndex])
}

model Map {
  id           String   @id @default(cuid())
  sceneId      String   @unique
  name         String
  backgroundId String?
  width        Int
  height       Int
  gridSize     Int      @default(70)
  gridType     GridType @default(SQUARE)
  bgColor      String   @default("#1a1a2e")
  showGrid     Boolean  @default(true)
  showFog      Boolean  @default(true)
  fogRevealed  Json     @default("[]")
  initialX     Float    @default(0)
  initialY     Float    @default(0)
  initialZoom  Float    @default(1)

  scene      Scene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  background Asset?     @relation("MapBackground", fields: [backgroundId], references: [id])
  layers     MapLayer[]
  tokens     Token[]
  walls      Wall[]
  lights     Light[]
}

model MapLayer {
  id      String    @id @default(cuid())
  mapId   String
  assetId String?
  name    String
  type    LayerType
  zIndex  Int
  opacity Float     @default(1)
  visible Boolean   @default(true)
  locked  Boolean   @default(false)
  offsetX Float     @default(0)
  offsetY Float     @default(0)
  scale   Float     @default(1)

  map   Map    @relation(fields: [mapId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id])
}

model Token {
  id          String  @id @default(cuid())
  mapId       String
  assetId     String?
  characterId String?
  name        String
  x           Float
  y           Float
  size        Float   @default(1)
  rotation    Float   @default(0)
  zIndex      Int     @default(0)
  borderColor String  @default("#ffffff")
  showName    Boolean @default(true)
  showHpBar   Boolean @default(true)
  isVisible   Boolean @default(true)
  isLocked    Boolean @default(false)

  map       Map        @relation(fields: [mapId], references: [id], onDelete: Cascade)
  asset     Asset?     @relation(fields: [assetId], references: [id])
  character Character? @relation(fields: [characterId], references: [id])

  @@index([mapId])
}

model Wall {
  id     String   @id @default(cuid())
  mapId  String
  points Json
  type   WallType @default(WALL)

  map Map @relation(fields: [mapId], references: [id], onDelete: Cascade)
}

model Light {
  id        String @id @default(cuid())
  mapId     String
  x         Float
  y         Float
  radius    Float
  color     String @default("#ffaa00")
  intensity Float  @default(1)

  map Map @relation(fields: [mapId], references: [id], onDelete: Cascade)
}

model Combat {
  id               String      @id @default(cuid())
  roomId           String
  round            Int         @default(1)
  phase            CombatPhase @default(ATB_CHARGING)
  tick             Int         @default(0)
  seed             String
  ruleSnapshot     Json
  ruleSnapshotHash String
  startedAt        DateTime    @default(now()) @db.Timestamptz(3)
  endedAt          DateTime?   @db.Timestamptz(3)

  room         Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participants CombatParticipant[]
  actions      CombatAction[]
  snapshots    CombatSnapshot[]

  @@index([roomId, endedAt])
}

model CombatParticipant {
  id          String  @id @default(cuid())
  combatId    String
  characterId String?
  isNPC       Boolean @default(false)
  npcData     Json?
  name        String
  atbValue    Float   @default(0)
  atbMax      Float
  speed       Float

  isReady       Boolean @default(false)
  currentHp     Int
  currentMp     Int
  currentSan    Int
  currentDp     Int     @default(0)
  maxHp         Int
  maxMp         Int
  maxSan        Int
  maxDp         Int     @default(0)
  statusEffects Json    @default("[]")
  isIdentified  Boolean @default(false)
  /// 对玩家公开属性（NPC/Boss）。
  isPublic      Boolean @default(false)
  spellState    Json    @default("{}")

  combat    Combat     @relation(fields: [combatId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id])

  @@index([combatId])
}

model CombatAction {
  id          String     @id @default(cuid())
  combatId    String
  seq         Int
  actorId     String
  type        ActionType
  payload     Json
  resolution  Resolution @default(PENDING)
  rollValue   Int?
  rollTarget  Int?
  damageDealt Int?
  rollSeed    String?
  ruleHash    String
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  combat Combat @relation(fields: [combatId], references: [id], onDelete: Cascade)

  @@unique([combatId, seq])
  @@index([combatId, createdAt])
}

model CombatSnapshot {
  id        String   @id @default(cuid())
  combatId  String
  seq       Int
  state     Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  combat Combat @relation(fields: [combatId], references: [id], onDelete: Cascade)

  @@unique([combatId, seq])
}

model Message {
  id        String      @id @default(cuid())
  roomId    String
  userId    String
  channel   Channel     @default(OOC)
  type      MessageType @default(CHAT)
  content   Json
  targetId  String?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  room   Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user   User  @relation("MessageAuthor", fields: [userId], references: [id], onDelete: Cascade)
  target User? @relation("WhisperTarget", fields: [targetId], references: [id])

  @@index([roomId, createdAt])
}

model DiceRoll {
  id         String         @id @default(cuid())
  roomId     String?
  userId     String
  expression String
  results    Json
  total      Int
  visibility RollVisibility @default(PUBLIC)
  seed       String
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  room Room? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

model Clue {
  id        String   @id @default(cuid())
  roomId    String
  title     String
  content   String
  isPublic  Boolean  @default(false)
  assetId   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  room         Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  asset        Asset?          @relation(fields: [assetId], references: [id])
  discoveredBy ClueDiscovery[]

  @@index([roomId])
}

model ClueDiscovery {
  clueId       String
  userId       String
  discoveredAt DateTime @default(now()) @db.Timestamptz(3)

  clue Clue @relation(fields: [clueId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clueId, userId])
}

model Note {
  id       String  @id @default(cuid())
  roomId   String
  userId   String
  title    String
  content  String
  isKPOnly Boolean @default(false)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, userId])
}

/// 角色卡「带进某个房间」的申请与 KP 审核状态。
/// 角色卡本身属于用户库（roomId 为 null），与房间解耦。
model RoomCharacterEntry {
  id          String       @id @default(cuid())
  roomId      String
  characterId String
  status      ReviewStatus @default(PENDING_REVIEW)
  comment     String?
  submittedAt DateTime     @default(now()) @db.Timestamptz(3)
  reviewedAt  DateTime?    @db.Timestamptz(3)

  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([roomId, characterId])
  @@index([roomId, status])
}

/// 卡牌「带进某个房间」的申请与 KP 审核状态。
/// 卡牌本身属于用户库，同一个房间不能重复带入同一张卡。
model RoomCardEntry {
  id          String       @id @default(cuid())
  roomId      String
  cardId      String
  status      ReviewStatus @default(PENDING_REVIEW)
  comment     String?
  submittedAt DateTime     @default(now()) @db.Timestamptz(3)
  reviewedAt  DateTime?    @db.Timestamptz(3)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([roomId, cardId])
  @@index([roomId, status])
}

/// 玩家发起的战斗申请。KP 发起时直接开战，不经过这张表。
model CombatRequest {
  id          String       @id @default(cuid())
  roomId      String
  initiatorId String
  status      ReviewStatus @default(PENDING_REVIEW)
  /// 参战单位与阵营划分：{ allies: [...], enemies: [...] }
  setup       Json         @default("{}")
  comment     String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  reviewedAt  DateTime?    @db.Timestamptz(3)

  room      Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  initiator User @relation("CombatRequestInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)

  @@index([roomId, status])
}

/// 管理员操作审计日志。
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorName  String?
  action     String
  targetType String
  targetId   String?
  detail     Json     @default("{}")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

/// 平台级设置，管理后台可修改，AI 导入等模块按需读取。
model SystemSetting {
  key       String   @id
  value     Json     @default("{}")
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

/// 团本章节预设，只读；应用团本预设时在房间内克隆为 RoomChapter。
model ChapterTemplate {
  id         String   @id @default(cuid())
  moduleId   String
  sourceKey  String
  title      String
  summary    String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, sourceKey])
  @@index([moduleId, orderIndex])
}

/// 场景 / 地图预设，只读。核心字段与 Scene + Map 对应，资源存相对路径，应用时解析为 Asset。
model SceneTemplate {
  id             String   @id @default(cuid())
  moduleId       String
  sourceKey      String
  name           String
  description    String?
  narration      String?
  weather        String   @default("NONE")
  timeOfDay      String   @default("DAY")
  width          Int      @default(1600)
  height         Int      @default(1000)
  gridSize       Int      @default(70)
  gridType       GridType @default(SQUARE)
  bgColor        String   @default("#1a1a2e")
  showGrid       Boolean  @default(true)
  showFog        Boolean  @default(false)
  backgroundPath String?
  bgMusicPath    String?
  ambientPath    String?
  layers         Json     @default("[]")
  tokens         Json     @default("[]")
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, sourceKey])
  @@index([moduleId, orderIndex])
}

/// NPC / Boss 预设，只读；应用时克隆为 Card(type=NPC, scope=ROOM)。
model NpcTemplate {
  id             String   @id @default(cuid())
  moduleId       String
  sourceKey      String
  name           String
  subtitle       String?
  description    String?
  tier           String   @default("STANDARD")
  rarity         String   @default("COMMON")
  race           String?
  tags           Json     @default("[]")
  attributes     Json     @default("{}")
  skills         Json     @default("{}")
  maxHp          Int      @default(10)
  maxMp          Int      @default(0)
  maxSan         Int      @default(0)
  maxDp          Int      @default(0)
  portraitPath   String?
  tokenPath      String?
  isPublicDefault Boolean @default(false)
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, sourceKey])
  @@index([moduleId, orderIndex])
}

/// 物品 / 武器 / 法器 / 证物预设，只读；应用时克隆为对应 Card。
model ItemTemplate {
  id          String           @id @default(cuid())
  moduleId    String
  sourceKey   String
  name        String
  itemType    ItemTemplateType @default(ITEM)
  description String?
  rarity      String           @default("COMMON")
  imagePath   String?
  stats       Json             @default("{}")
  quantity    Int              @default(1)
  orderIndex  Int              @default(0)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, sourceKey])
  @@index([moduleId, orderIndex])
}

/// 线索 / 手书预设，只读；应用时克隆为 Clue，必要时关联证物卡。
model ClueTemplate {
  id             String   @id @default(cuid())
  moduleId       String
  sourceKey      String
  title          String
  content        String   @default("")
  imagePath      String?
  linkedItemKey  String?
  isPublicDefault Boolean @default(false)
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, sourceKey])
  @@index([moduleId, orderIndex])
}

/// 遭遇预设，只读；应用时克隆为 Encounter，并把内部引用重写到房间实体 id。
model EncounterTemplate {
  id         String   @id @default(cuid())
  moduleId   String
  sourceKey  String
  title      String
  chapterKey String?
  sceneKey   String?
  trigger    String?
  setup      Json     @default("{}")
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, sourceKey])
  @@index([moduleId, orderIndex])
}

/// 魔法 / 法术预设，只读；应用时写入房间的 magic 规则。
model MagicTemplate {
  id          String   @id @default(cuid())
  moduleId    String
  sourceKey   String
  name        String
  skill       String   @default("OCCULT")
  description String?
  mpCost      String   @default("0")
  sanCost     String   @default("0")
  damage      String?
  target      String   @default("ONE")
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, sourceKey])
  @@index([moduleId, orderIndex])
}

/// 房间级章节实例：从 ChapterTemplate 克隆，保证不同房间互不影响。
model RoomChapter {
  id               String   @id @default(cuid())
  roomId           String
  sourceTemplateId String?
  title            String
  summary          String?
  orderIndex       Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  room       Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  encounters Encounter[] @relation("EncounterRoomChapter")

  @@index([roomId, orderIndex])
}

/// 一次“应用团本预设”的记录；换预设时旧记录标记 REPLACED，旧实例整批清理。
model RoomPresetApplication {
  id               String   @id @default(cuid())
  roomId           String
  moduleId         String
  moduleRevisionId String?
  status           String   @default("ACTIVE")
  appliedBy        String
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  replacedAt       DateTime? @db.Timestamptz(3)

  room      Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  module    Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  instances RoomPresetInstance[]

  @@index([roomId, status])
  @@index([moduleId])
}

/// 预设 → 房间实例的映射，用于幂等、换预设清理、重新同步。
model RoomPresetInstance {
  id            String   @id @default(cuid())
  applicationId String
  templateType  String
  templateId    String
  entityId      String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  application RoomPresetApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([templateType, entityId])
}
