# ============================================================
# 生产环境变量模板（阿里云 RDS + SAE）
# 真实值放 SAE 的「环境变量」配置里，或 GitHub Secrets，绝不提交
# ============================================================

# RDS 内网地址（SAE 与 RDS 同地域时用内网，免流量费且延迟低）
# sslmode=require 必加；connection_limit 按 RDS 规格调，别用 Prisma 默认值
DATABASE_URL="postgresql://user:password@rm-xxxxxx.pg.rds.aliyuncs.com:5432/touhou_trpg?schema=public&sslmode=require&connection_limit=10&pool_timeout=20"

# 用 openssl rand -base64 32 生成
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="https://your-domain.com"

# SAE 要求监听 0.0.0.0；端口需与 SAE 应用配置一致
HOST="0.0.0.0"
PORT="3000"
