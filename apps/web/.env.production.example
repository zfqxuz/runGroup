# ============================================================
# 生产环境变量模板（阿里云 ECS + Docker PostgreSQL）
# 实际文件放服务器 /opt/touhou-trpg/.env，权限 600，绝不提交 Git。
# ============================================================

# GitHub Actions 每次部署会自动覆盖这一行
APP_IMAGE="ghcr.io/zfqxuz/rungroup:latest"

# docker compose 里的 PostgreSQL 容器凭据
POSTGRES_USER="touhou"
POSTGRES_PASSWORD="replace-with-strong-url-safe-password"
POSTGRES_DB="touhou_trpg"

# 应用只监听容器内 3000；compose 默认映射到宿主机 127.0.0.1:3000
HOST="0.0.0.0"
PORT="3000"

# 如果直接通过 http://8.141.16.85:3000 访问，就填这个；
# 如果前面挂了 Nginx / Caddy 和域名，改成 https://your-domain.com
NEXTAUTH_URL="http://8.141.16.85:3000"

# openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"

# 上传文件（线索图片、团本素材等）在 compose 中挂到 ./uploads
UPLOAD_DIR="/data/uploads"

# DeepSeek 模型（n8n 工作流必填；仅当不启用 n8n 时才可只用它做回退）
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

# 一般不需要手动设置：compose 会用 POSTGRES_* 自动拼成 db:5432 的 DATABASE_URL
# DATABASE_URL="postgresql://touhou:password@db:5432/touhou_trpg?schema=public"

# n8n 团本解析工作流（推荐）。应用默认通过 Docker 内网调用。
# 服务器 compose 会启动 n8n 并自动导入 n8n/workflows/module-import.json。
N8N_MODULE_PARSE_URL="http://n8n:5678/webhook/module-parse"
N8N_REQUEST_TIMEOUT_MS="1800000"
# n8n 镜像；国内服务器默认走 daocloud 镜像前缀
N8N_IMAGE="docker.m.daocloud.io/n8nio/n8n:2.39.5"
# 可选：n8n Webhook 共享密钥；设置后应用会发送 x-n8n-webhook-secret 请求头。
# N8N_WEBHOOK_SECRET=""
# 可选：n8n 编辑器公网/内网地址；默认只绑定 127.0.0.1:5678。
# N8N_PUBLIC_URL="http://127.0.0.1:5678"
# 可选：固定 n8n 加密密钥，避免重建容器后凭据失效；不填时 n8n 自动生成到卷中。
# N8N_ENCRYPTION_KEY=""
