# ============================================================
# 生产环境变量模板（阿里云 ECS + Docker PostgreSQL）
# 实际文件放服务器 /opt/touhou-trpg/.env，权限 600，绝不提交 Git。
# ============================================================

# GitHub Actions 每次部署会自动覆盖这一行
APP_IMAGE="registry.cn-hangzhou.aliyuncs.com/<acr-namespace>/touhou-trpg:latest"

# docker compose 里的 PostgreSQL 容器凭据
POSTGRES_USER="touhou"
POSTGRES_PASSWORD="replace-with-strong-url-safe-password"
POSTGRES_DB="touhou_trpg"

# 应用只监听容器内 3000；compose 默认映射到宿主机 127.0.0.1:3000
HOST="0.0.0.0"
PORT="3000"

# 如果直接通过 http://8.141.16.85:3000 访问，就填这个；
# 如果前面挂了 Nginx / Caddy 和域名，改成 https://your-domain.com
NEXTAUTH_URL="http://8.141.16.85:3000"

# openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"

# 上传文件（线索图片、团本素材等）在 compose 中挂到 ./uploads
UPLOAD_DIR="/data/uploads"

# DeepSeek 智能团本导入（可选）
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

# 一般不需要手动设置：compose 会用 POSTGRES_* 自动拼成 db:5432 的 DATABASE_URL
# DATABASE_URL="postgresql://touhou:password@db:5432/touhou_trpg?schema=public"
